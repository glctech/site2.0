{
  "$schema": "./schema/home.schema.json",
  "hero": {
    "badge": { "i18n": "hero.badge", "text": "Monitoramento em tempo real · Zabbix & Grafana" },
    "headline": {
      "i18n": "hero.h1.full",
      "html": "<span>Visibilidade Total</span><br><span>da Sua</span> <span style=\"color:var(--red)\">Infraestrutura</span><br><span>de TI</span>"
    },
    "subhead": { "i18n": "hero.p", "text": "Detectamos falhas antes que impactem seu negócio. Monitoramento inteligente, segurança avançada e suporte especializado — tudo em um único parceiro." },
    "ctaPrimary":   { "i18n": "hero.cta1", "text": "Solicitar Diagnóstico", "href": "#contact" },
    "ctaSecondary": { "i18n": "hero.cta2", "text": "Ver Soluções", "href": "#services" }
  },
  "stats": [
    { "id": "devices",  "value": 144,     "dynamic": true,  "suffix": "+",    "desc": { "i18n": "stat.snmp",     "text": "Devices monitorados via SNMP" } },
    { "id": "capacity", "value": "3k",    "dynamic": false, "suffix": "+",    "desc": { "i18n": "stat.capacity", "text": "Capacidade total de monitoramento" } },
    { "id": "uptime",   "value": "99",    "dynamic": false, "suffix": ".9%",  "desc": { "i18n": "stat.uptime",   "text": "SLA de disponibilidade" } },
    { "id": "support",  "value": "24/7",  "dynamic": false, "suffix": "",     "desc": { "i18n": "stat.support",  "text": "Suporte e monitoramento" } }
  ]
}
